# ── LM Studio (local OpenAI-compatible API) ────────────────────────────────────
# Base URL of LM Studio server
LMSTUDIO_BASE_URL=http://192.168.7.98:1234/v1
# Model identifier shown in LM Studio (e.g. qwen3.5-9b or the full path)
LMSTUDIO_MODEL=qwen3.5-9b
# API key - LM Studio accepts any string
LMSTUDIO_API_KEY=sk-lm-sr7C9OUt:SvjfR8FrJjfFopC6d27v

# ── faster-whisper ─────────────────────────────────────────────────────────────
# Model size: tiny / base / small / medium / large-v3
WHISPER_MODEL_SIZE=paraformer-zh
# Device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute type: int8 (CPU), float16 (GPU)
WHISPER_COMPUTE_TYPE=int8

# ── VRED / Strapi ──────────────────────────────────────────────────────────────
# Strapi server URL (where POST /processes/execute-python is hosted)
STRAPI_BASE_URL=http://localhost:1337
# IP and port of the VRED instance to control
VRED_IP=localhost
VRED_PORT=8888

# ── Service ────────────────────────────────────────────────────────────────────
SERVICE_PORT=8765
SERVER_IP=192.168.7.81
