{
  "kind": "collectionType",
  "collectionName": "app_roles",
  "info": {
    "singularName": "app-role",
    "pluralName": "app-roles",
    "displayName": "App Role",
    "description": "Business role inside mr-platform (e.g. VP / 数字主管)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "canManage": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "isSystem": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "users": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::app-user.app-user",
      "mappedBy": "appRole"
    }
  }
}
